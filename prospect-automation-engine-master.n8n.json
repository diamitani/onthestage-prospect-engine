        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"⚠️ *Prospect Automation Review Queue*: Lead {{ $json.email }} at {{ $json.company_name }} requires manual copy review before sequence dispatch.\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1220,
        480
      ],
      "id": "node-09-approval-notify",
      "name": "09 Send Approval Review Notification"
    }
